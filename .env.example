# ===== NordBygg backend configuration =====
# Copy this file to ".env" and fill in your SMTP credentials.
# All form submissions are emailed to MAIL_TO.

# Where submissions are delivered
MAIL_TO=haboub.m@hotmail.com

# Server port (optional)
PORT=3000

# Public site URL — used in sitemap.xml (set your real domain before going live)
SITE_URL=https://www.nordbygg.se

# ----- Admin panel -----
# Password for logging in at /admin. CHANGE THIS to something only you know.
ADMIN_PASSWORD=byt-detta-losenord

# ----- SMTP (outgoing email) -----
# Use any provider. Two common examples:
#
# Gmail (requires a 16-char "App Password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=your-app-password
#
# Outlook / Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.address@outlook.com
#   SMTP_PASS=your-password-or-app-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The "From" address shown on outgoing mail (defaults to SMTP_USER if blank).
SMTP_FROM=
