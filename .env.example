# ===== Binaafy — environment =====
# Copy to .env.local for development. Set the real values in Vercel for production.

# Public site URL — every canonical/OG/sitemap URL derives from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Supabase (Phase 2) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API route handlers to write leads. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Mail (Phase 4) -----
RESEND_API_KEY=
# Where new leads are sent. Several addresses: comma-separated, e.g. a@binaafy.se,b@binaafy.se
MAIL_TO=info@binaafy.se
# Sender, once binaafy.se is verified in Resend, e.g. "Binaafy <hej@binaafy.se>".
# Leave empty until then: internal notices use Resend's test sender (which can
# only deliver to the Resend account's own address) and customer auto-replies are skipped.
MAIL_FROM=

# ----- Analytics (Phase 4) -----
NEXT_PUBLIC_GA_ID=

# ----- Admin (Phase 2) -----
# Comma-separated allowlist of admin account emails.
ADMIN_EMAILS=

# ----- Fakturering (docs/fakturering.md) -----
# Vercel sends this as a bearer token to /api/cron/invoices (the daily reminder run).
CRON_SECRET=
# 1 = the cron sends reminders by itself; empty = it only lists them on the Ekonomi page.
REMINDERS_AUTO=
# Days after the due date before the first reminder, and between reminders.
REMINDERS_GRACE_DAYS=3
REMINDERS_DAYS_BETWEEN=10
# 1 = charge the statutory 60 kr fee to private customers too (only if the terms say so).
REMINDERS_FEE_TO_CONSUMERS=
# The company's Swish number (Swish Företag). Prints a QR on invoices and in the portal.
SWISH_NUMBER=

# ----- Swish Handel (lib/core/payments/swish-commerce.ts) -----
# "Betala med Swish" on the invoice; the payment is confirmed by Swish's
# callback the second the customer pays. Needs the bank's Swish Handel
# agreement and a client certificate per Swish number (Swish Certificate
# Management, portal.swish.nu). The website's organisation reads these;
# other organisations name their own source in org_settings
# (payment.swishCommerce.credentials = "env:<PREFIX>" or "vault:swish_<name>").
# Never commit a certificate or key. Each value is the PEM itself (newlines
# may be written \n) or the PEM base64-encoded on one line.
# Client certificate (with the chain) and its private key:
SWISH_CERT_PEM=
SWISH_KEY_PEM=
# Only if the key is encrypted:
SWISH_KEY_PASSPHRASE=
# Swish's TLS root CA (prod: DigiCert Global Root G2, which Node already
# trusts; test: Swish_TLS_RootCA.pem from the MSS test package).
SWISH_CA_PEM=
# test = Merchant Swish Simulator (mss.cpc.getswish.net, no real money); prod = cpc.getswish.net.
SWISH_ENV=test
# Signs our callback URL (HMAC). At least 32 random characters, e.g. `openssl rand -hex 32`.
SWISH_CALLBACK_SECRET=
# Optional: another https base for the callback than NEXT_PUBLIC_SITE_URL,
# e.g. a tunnel to localhost when testing against the simulator.
SWISH_CALLBACK_BASE_URL=
