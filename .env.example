# ===== Binaafy — environment =====
# Copy to .env.local for development. Set the real values in Vercel for production.

# Public site URL — every canonical/OG/sitemap URL derives from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Supabase (Phase 2) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API route handlers to write leads. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Mail (Phase 4) -----
RESEND_API_KEY=
# Where new leads are sent. Several addresses: comma-separated, e.g. a@binaafy.se,b@binaafy.se
MAIL_TO=info@binaafy.se
# Sender, once binaafy.se is verified in Resend, e.g. "Binaafy <hej@binaafy.se>".
# Leave empty until then: internal notices use Resend's test sender (which can
# only deliver to the Resend account's own address) and customer auto-replies are skipped.
MAIL_FROM=

# ----- Analytics (Phase 4) -----
NEXT_PUBLIC_GA_ID=

# ----- Admin (Phase 2) -----
# Comma-separated allowlist of admin account emails.
ADMIN_EMAILS=

# ----- Fakturering (docs/fakturering.md) -----
# Vercel sends this as a bearer token to /api/cron/invoices (the daily reminder run).
CRON_SECRET=
# 1 = the cron sends reminders by itself; empty = it only lists them on the Ekonomi page.
REMINDERS_AUTO=
# Days after the due date before the first reminder, and between reminders.
REMINDERS_GRACE_DAYS=3
REMINDERS_DAYS_BETWEEN=10
# 1 = charge the statutory 60 kr fee to private customers too (only if the terms say so).
REMINDERS_FEE_TO_CONSUMERS=
# The company's Swish number (Swish Företag). Prints a QR on invoices and in the portal.
SWISH_NUMBER=
